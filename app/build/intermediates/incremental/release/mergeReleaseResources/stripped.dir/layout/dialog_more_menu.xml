<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="wrap_content"
     app:cardElevation="2dp"
     app:strokeWidth="0dp"
     app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
     app:cardCornerRadius="24dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:padding="4dp"
         android:orientation="vertical">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:orientation="vertical"
             android:paddingBottom="12dp"
             android:paddingHorizontal="20dp"
             android:paddingTop="16dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:textSize="11sp"
                 android:textAllCaps="true"
                 android:textColor="?attr/colorPrimary"
                 android:letterSpacing="0.08"
                 android:text="Opsi File"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:ellipsize="middle"
                 android:textSize="14sp"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:layout_marginTop="2dp"
                 android:maxLines="1"
                 android:id="@+id/tvMenuFileName"
                 android:text="nama_file.ext"
                 android:textStyle="bold" />

        </LinearLayout>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:layout_marginVertical="6dp"
             android:background="?attr/colorSurfaceVariant"
             android:alpha="0.5"
             android:layout_marginHorizontal="16dp" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuRename">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_edit"
                 app:tint="?attr/colorOnSurfaceVariant"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorOnSurface"
                     android:text="Ubah Nama" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="10sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:text="Ubah nama file ini" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuMove">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_move"
                 app:tint="?attr/colorOnSurfaceVariant"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/tvMoveTitle"
                     android:text="Pindahkan" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="10sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:id="@+id/tvMoveSub"
                     android:text="Pindahkan ke folder lain" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuCopy">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_copy"
                 app:tint="?attr/colorOnSurfaceVariant"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/tvCopyTitle"
                     android:text="Salin" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="10sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:id="@+id/tvCopySub"
                     android:text="Salin ke folder lain" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuShare">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_share"
                 app:tint="?attr/colorOnSurfaceVariant"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorOnSurface"
                     android:text="Bagikan" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="10sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:text="Kirim file ke perangkat lain" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuCompress">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_compress"
                 app:tint="?attr/colorOnSurfaceVariant"
                 android:id="@+id/ivCompressIcon"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorOnSurface"
                     android:id="@+id/tvCompressTitle"
                     android:text="Kompres" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="10sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:id="@+id/tvCompressSub"
                     android:text="Jadikan file zip" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuProperties">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_info"
                 app:tint="?attr/colorOnSurfaceVariant"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorOnSurface"
                     android:text="Informasi" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="10sp"
                     android:textColor="?attr/colorOnSurfaceVariant"
                     android:text="Lihat detail file" />

            </LinearLayout>

        </LinearLayout>

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:layout_marginVertical="6dp"
             android:background="?attr/colorSurfaceVariant"
             android:alpha="0.5"
             android:layout_marginHorizontal="16dp" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:layout_marginBottom="4dp"
             android:gravity="center_vertical"
             android:background="?attr/selectableItemBackground"
             android:clickable="true"
             android:minHeight="56dp"
             android:paddingVertical="8dp"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:focusable="true"
             android:id="@+id/menuDelete">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:src="@drawable/ic_delete"
                 app:tint="?attr/colorError"
                 android:layout_gravity="center_vertical" />

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:orientation="vertical"
                 android:layout_marginStart="16dp"
                 android:layout_gravity="center_vertical">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:textSize="14sp"
                     android:textColor="?attr/colorError"
                     android:text="Hapus" />

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:alpha="0.8"
                     android:textSize="10sp"
                     android:textColor="?attr/colorError"
                     android:text="Hapus file dari perangkat" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>