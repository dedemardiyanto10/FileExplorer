<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:orientation="vertical"
     android:paddingTop="24dp"
     android:paddingHorizontal="24dp">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:textSize="16sp"
         android:textAllCaps="true"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:letterSpacing="0.08"
         android:textStyle="bold"
         android:id="@+id/tvHeader"
         android:text="Ubah Nama Banyak File" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         android:textSize="13sp"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:layout_marginTop="4dp"
         android:text="Pilih metode penamaan massal untuk file yang dipilih" />

    <RadioGroup
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:id="@+id/radioGroupBatchMode">

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingVertical="4dp"
             android:textSize="14sp"
             android:textColor="?attr/colorOnSurface"
             android:checked="true"
             android:id="@+id/radioCustomPattern"
             android:text="Nama baru + Nomor berurutan" />

        <RadioButton
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingVertical="4dp"
             android:textSize="14sp"
             android:textColor="?attr/colorOnSurface"
             android:layout_marginTop="4dp"
             android:id="@+id/radioChangeExtensionOnly"
             android:text="Pertahankan nama asli (Ubah ekstensi saja)" />

    </RadioGroup>

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:orientation="vertical"
         android:id="@+id/layoutCustomPattern">

        <com.google.android.material.textfield.TextInputLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             app:boxCornerRadiusTopEnd="32dp"
             android:hint="Nama Baru"
             app:boxCornerRadiusBottomStart="32dp"
             app:boxCornerRadiusBottomEnd="32dp"
             app:startIconTint="?attr/colorPrimary"
             style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
             app:startIconDrawable="@drawable/ic_edit"
             app:boxCornerRadiusTopStart="32dp">

            <com.google.android.material.textfield.TextInputEditText
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:singleLine="true"
                 android:maxLines="1"
                 android:id="@+id/inputNewName" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             app:boxCornerRadiusTopEnd="32dp"
             android:hint="Mulai dari Nomor (Contoh: 1)"
             app:boxCornerRadiusBottomStart="32dp"
             app:boxCornerRadiusBottomEnd="32dp"
             app:startIconTint="?attr/colorPrimary"
             style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
             android:layout_marginTop="12dp"
             app:startIconDrawable="@drawable/ic_info"
             app:boxCornerRadiusTopStart="32dp">

            <com.google.android.material.textfield.TextInputEditText
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:singleLine="true"
                 android:maxLines="1"
                 android:inputType="number"
                 android:id="@+id/inputStartNumber"
                 android:text="1" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         app:boxCornerRadiusTopEnd="32dp"
         android:hint="Ekstensi Baru (Opsional, cth: .jpg)"
         app:boxCornerRadiusBottomStart="32dp"
         app:boxCornerRadiusBottomEnd="32dp"
         app:startIconTint="?attr/colorPrimary"
         style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
         android:layout_marginTop="12dp"
         app:startIconDrawable="@drawable/ic_file"
         app:boxCornerRadiusTopStart="32dp">

        <com.google.android.material.textfield.TextInputEditText
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:singleLine="true"
             android:maxLines="1"
             android:id="@+id/inputNewExtension" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>