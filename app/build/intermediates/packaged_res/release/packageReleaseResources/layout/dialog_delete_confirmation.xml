<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="match_parent"
     android:orientation="vertical"
     android:paddingTop="24dp"
     android:paddingHorizontal="24dp">

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:textSize="16sp"
         android:textAllCaps="true"
         android:textColor="?attr/colorError"
         android:letterSpacing="0.08"
         android:textStyle="bold"
         android:id="@+id/tvHeader"
         android:text="Hapus File" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:layout_marginBottom="16dp"
         android:textSize="13sp"
         android:id="@+id/tvDeleteSub"
         android:textColor="?attr/colorOnSurfaceVariant"
         android:layout_marginTop="4dp"
         android:text="Tindakan ini tidak dapat dibatalkan" />

    <TextView
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:textSize="14sp"
         android:textColor="?attr/colorOnSurface"
         android:id="@+id/tvDeleteMessage"
         android:singleLine="true"
         android:text="Apakah Anda yakin ingin menghapus file ini?" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:visibility="gone"
         android:orientation="vertical"
         android:layout_marginTop="16dp"
         android:id="@+id/layoutProgress">

        <com.google.android.material.progressindicator.LinearProgressIndicator
             android:layout_height="4dp"
             android:layout_width="match_parent"
             android:max="100"
             android:indeterminate="false"
             style="@style/Widget.Material3Expressive.LinearProgressIndicator.Wavy"
             app:trackColor="?attr/colorSurfaceVariant"
             android:progress="0"
             android:id="@+id/progressDelete"
             app:indicatorColor="?attr/colorError" />

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:gravity="end"
             android:orientation="horizontal"
             android:layout_marginTop="4dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="12sp"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:id="@+id/tvProgressPercent"
                 android:text="0%" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>