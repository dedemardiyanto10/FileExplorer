<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="wrap_content"
     android:layout_width="wrap_content"
     app:cardElevation="2dp"
     app:strokeWidth="0dp"
     app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
     app:cardCornerRadius="24dp">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:padding="4dp"
         android:orientation="vertical">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:textAppearance="?attr/textAppearanceTitleSmall"
             android:paddingBottom="8dp"
             android:textColor="?attr/colorOnSurfaceVariant"
             android:paddingHorizontal="20dp"
             android:paddingTop="8dp"
             android:text="Urutkan menurut" />

        <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:layout_marginVertical="6dp"
             android:background="?attr/colorSurfaceVariant"
             android:alpha="0.5"
             android:layout_marginHorizontal="16dp" />

        <LinearLayout
             android:layout_height="48dp"
             android:layout_width="match_parent"
             android:background="?attr/selectableItemBackground"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:id="@+id/optionSortName">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:visibility="invisible"
                 android:layout_marginEnd="16dp"
                 android:src="@drawable/ic_checked"
                 app:tint="?attr/colorPrimary"
                 android:id="@+id/ivCheckName" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textAppearance="?attr/textAppearanceBodyMedium"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:text="Nama" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="48dp"
             android:layout_width="match_parent"
             android:background="?attr/selectableItemBackground"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:id="@+id/optionSortDate">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:visibility="invisible"
                 android:layout_marginEnd="16dp"
                 android:src="@drawable/ic_checked"
                 app:tint="?attr/colorPrimary"
                 android:id="@+id/ivCheckDate" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textAppearance="?attr/textAppearanceBodyMedium"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:text="Tanggal diubah" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="48dp"
             android:layout_width="match_parent"
             android:background="?attr/selectableItemBackground"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:id="@+id/optionSortSize">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:visibility="invisible"
                 android:layout_marginEnd="16dp"
                 android:src="@drawable/ic_checked"
                 app:tint="?attr/colorPrimary"
                 android:id="@+id/ivCheckSize" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textAppearance="?attr/textAppearanceBodyMedium"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:text="Ukuran file" />

        </LinearLayout>

         <View
             android:layout_height="1dp"
             android:layout_width="match_parent"
             android:layout_marginVertical="6dp"
             android:background="?attr/colorSurfaceVariant"
             android:alpha="0.5"
             android:layout_marginHorizontal="16dp" />

        <LinearLayout
             android:layout_height="48dp"
             android:layout_width="match_parent"
             android:background="?attr/selectableItemBackground"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:id="@+id/optionOrderAsc">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:visibility="invisible"
                 android:layout_marginEnd="16dp"
                 android:src="@drawable/ic_checked"
                 app:tint="?attr/colorPrimary"
                 android:id="@+id/ivCheckAsc" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textAppearance="?attr/textAppearanceBodyMedium"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:text="A ke Z" />

        </LinearLayout>

        <LinearLayout
             android:layout_height="48dp"
             android:layout_width="match_parent"
             android:background="?attr/selectableItemBackground"
             android:gravity="center_vertical"
             android:orientation="horizontal"
             android:paddingHorizontal="20dp"
             android:id="@+id/optionOrderDesc">

            <ImageView
                 android:layout_height="20dp"
                 android:layout_width="20dp"
                 android:visibility="invisible"
                 android:layout_marginEnd="16dp"
                 android:src="@drawable/ic_checked"
                 app:tint="?attr/colorPrimary"
                 android:id="@+id/ivCheckDesc" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textAppearance="?attr/textAppearanceBodyMedium"
                 android:textColor="?attr/colorOnSurfaceVariant"
                 android:text="Z ke A" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>