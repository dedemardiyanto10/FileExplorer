<resources xmlns:tools="http://schemas.android.com/tools">
    <style
        name="Base.AppTheme"
        parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
  </style>

    <style
            name="CustomBottomDialogTheme"
            parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowAnimationStyle">@style/DialogSlideAnimation</item>
    </style>

    <style name="DialogSlideAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up_in</item>
        <item name="android:windowExitAnimation">@anim/slide_down_out</item>
    </style>

    <style
        name="AppTheme"
        parent="Base.AppTheme" />
</resources>
